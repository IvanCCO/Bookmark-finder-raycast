{
  "name": "bookmark-finder",
  "version": "0.1.0",
  "description": "Busca em linguagem natural nos favoritos e itens fixos do navegador, com descrições e categorias geradas por IA.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file=.env server/index.mjs",
    "sync": "node --env-file=.env server/cli.mjs sync",
    "recluster": "node --env-file=.env server/cli.mjs recluster",
    "regenerate": "node --env-file=.env server/cli.mjs regenerate",
    "status": "node --env-file=.env server/cli.mjs status",
    "test": "node --test \"tests/*.test.mjs\""
  }
}
